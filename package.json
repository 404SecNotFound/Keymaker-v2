{
  "name": "keymaker",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-crypto-worker.mjs && next dev -p 9002",
    "build": "node scripts/build-crypto-worker.mjs && node scripts/build-recovery-kit.mjs && next build && node scripts/apply-csp-hashes.mjs && node scripts/apply-build-id.mjs && node scripts/build-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "test:crypto": "node scripts/crypto-regression.mts",
    "test:keymaker": "node scripts/keymaker-test.mjs",
    "test:keym2-dispatch": "node scripts/keymaker-test.mjs keym2-dispatch",
    "test:calibration": "node scripts/keymaker-test.mjs calibration",
    "test:fuzz": "node scripts/keymaker-test.mjs fuzz",
    "test:browser": "playwright test",
    "test:conformance": "python3 reference/crosstest.py",
    "test:keym2": "python3 reference/keym2.py selftest",
    "test:conformance2": "python3 reference/crosstest2.py",
    "test:recovery": "python3 reference/recovery_test.py",
    "test:wordlist": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-wordlist.mjs",
    "test:release-notes": "node scripts/release-notes-test.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "build:worker": "node scripts/build-crypto-worker.mjs",
    "verify:reproducible": "node scripts/verify-reproducible.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.18",
    "sigstore": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "^3.3.17",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "ws": "^8.18.3"
  }
}
